# Copy to .env and fill — Coolify/Hetzner will inject these
# AI providers (at least one required for /admin/ai-fetch)
XAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
ZAI_API_KEY=
RAWG_API_KEY=

# Banner / enrich tunables (optional, defaults in src/lib/config.ts)
# AI_ENRICH_CONCURRENCY=3
# BANNER_TIMEOUT_MS=9000
# IMPORT_RESOLVE_BATCH=15
# BROWSER_MAX_CONTEXTS=2

# Admin auth — password + optional 2FA (Authenticator) + optional Gmail allowlist
# - ADMIN_PASSWORD: required in production (no fallback). Set a strong random string.
# - ADMIN_EMAIL: your Gmail for Google Sign-In allowlist (optional but recommended)
# - TOTP_SECRET: base32 secret for Authenticator app (Google Authenticator/Authy). Generate via /admin/setup-2fa
ADMIN_PASSWORD=
ADMIN_EMAIL=
TOTP_SECRET=
# Legacy alias (still checked):
ADMIN_TOKEN=

# Google OAuth for Gmail linking (get from https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-to-random-32-chars

# Persistent volume path (Coolify sets /app/data automatically)
DATA_DIR=/app/data

# Optional: override FDM affiliate link
# FDM_AFFILIATE_URL=https://www.freedownloadmanager.org/
